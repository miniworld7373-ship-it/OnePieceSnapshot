{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "onepiece-snapshot-trigger",
  "main": "index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "triggers": { "crons": ["*/10 * * * *"] },
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "onepiece-snapshot" }],
  "observability": { "enabled": true }
}
